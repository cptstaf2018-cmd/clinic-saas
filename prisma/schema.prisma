generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id                     String            @id @default(cuid())
  name                   String
  whatsappNumber         String?           @unique
  createdAt              DateTime          @default(now())
  botEnabled             Boolean           @default(true)
  logoUrl                String?
  address                String?
  locationUrl            String?
  facilityType           String            @default("clinic")
  specialty              String?
  specialtyOnboardingRequired Boolean @default(false)
  whatsappAccessToken    String?
  whatsappWebhookSecret  String?
  whatsappPhoneNumberId  String?
  whatsappWelcomeMessage String?
  botOutOfScopeMessage   String?
  botMedicalDisclaimer   String?
  botHandoffMessage      String?
  botShowWorkingHours    Boolean           @default(true)
  botShowLocation        Boolean           @default(false)
  backupEmail            String?
  doctorDegree           String?
  doctorUniversity       String?
  doctorBoard            String?
  slideshowImages        String[]
  appointments           Appointment[]
  incomingMessages       IncomingMessage[]
  medicalRecords         MedicalRecord[]
  patientAttachments     PatientAttachment[]
  patientPayments        PatientPayment[]
  patients               Patient[]
  toothTreatments        ToothTreatment[]
  specialtyAnnotations   SpecialtyAnnotation[]
  payments               Payment[]
  subscription           Subscription?
  settings               ClinicSettings?
  featureTrials          ClinicFeatureTrial[]
  systemEvents           SystemEvent[]
  users                  User[]
  workingHours           WorkingHours[]
  pharmacyProducts       PharmacyProduct[]
  pharmacySales          PharmacySale[]
  labTests               LabTest[]
  labOrders              LabOrder[]
}

model User {
  id           String   @id @default(cuid())
  clinicId     String?
  email        String?  @unique
  passwordHash String
  role         String   @default("doctor")
  createdAt    DateTime @default(now())
  clinic       Clinic?  @relation(fields: [clinicId], references: [id])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model InvitationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  clinicId  String?
  createdAt DateTime  @default(now())

  @@index([code])
}

model Subscription {
  id        String   @id @default(cuid())
  clinicId  String   @unique
  plan      String   @default("trial")
  status    String   @default("trial")
  startDate DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
}

model ClinicSettings {
  clinicId       String   @id @map("clinic_id")
  specialtyCode  String   @map("specialty_code")
  setupCompleted Boolean  @default(true) @map("setup_completed")
  updatedAt      DateTime @updatedAt @map("updated_at")
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_settings")
}

model Patient {
  id                 String   @id @default(cuid())
  clinicId           String
  name               String
  whatsappPhone      String
  createdAt          DateTime @default(now())
  bloodType          String?
  allergies          String[]
  chronicConditions  String[]
  currentMedications String[]
  surgicalHistory    String?
  smokingStatus      String?
  appointments        Appointment[]
  medicalRecords      MedicalRecord[]
  patientAttachments  PatientAttachment[]
  patientPayments     PatientPayment[]
  toothTreatments     ToothTreatment[]
  specialtyAnnotations SpecialtyAnnotation[]
  clinic              Clinic              @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, whatsappPhone])
  @@index([clinicId])
}

model ToothTreatment {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  toothNumber Int
  treatment   String   // filling | extraction | rootCanal | crown | cleaning | implant | other
  notes       String?
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic      Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId, patientId])
}

model Appointment {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String
  date            DateTime
  status          String   @default("pending")
  queueNumber     Int?
  queueStatus     String   @default("waiting")
  reminder24hSent Boolean   @default(false)
  reminder1hSent  Boolean   @default(false)
  cheerAt         DateTime?
  cheerSent       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  patient         Patient  @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([clinicId, date])
  @@index([clinicId, status])
  @@index([clinicId, reminder24hSent, date])
  @@index([clinicId, reminder1hSent, date])
}

model PatientPayment {
  id            String      @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  amount        Int
  note          String?
  createdAt     DateTime    @default(now())
  clinic        Clinic      @relation(fields: [clinicId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([clinicId, createdAt])
}

model WorkingHours {
  id        String  @id @default(cuid())
  clinicId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isOpen    Boolean @default(true)
  clinic    Clinic  @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, dayOfWeek])
  @@index([clinicId])
}

model WhatsappSession {
  id        String   @id @default(cuid())
  clinicId  String
  phone     String
  step      String
  updatedAt DateTime @updatedAt

  @@unique([clinicId, phone])
  @@index([clinicId])
}

model IncomingMessage {
  id        String   @id @default(cuid())
  clinicId  String
  phone     String
  body      String
  read      Boolean  @default(false)
  direction String   @default("inbound")
  status    String   @default("received")
  error     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([clinicId, archived])
  @@index([clinicId, read])
  @@index([clinicId, phone])
  @@index([clinicId, direction])
}

model Payment {
  id        String   @id @default(cuid())
  clinicId  String
  amount    Int
  method    String
  status    String   @default("pending")
  reference String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([status])
}

model PlatformSettings {
  id               String  @id @default("singleton")
  logoUrl          String?
  adminWasenderKey String?
}

model ClinicFeatureTrial {
  id        String   @id @default(cuid())
  clinicId  String
  feature   String
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, feature])
  @@index([clinicId])
  @@index([feature])
}

model MedicalRecord {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String
  date         DateTime @default(now())
  complaint    String
  diagnosis    String?
  prescription String?
  notes        String?
  followUpDate DateTime?
  specialtyCode String?
  contentJson  Json?
  createdAt    DateTime @default(now())
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  patient      Patient  @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, patientId])
}

model PatientAttachment {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  type      String   // "lab" | "xray" | "prescription" | "other"
  title     String
  notes     String?
  fileUrl   String?
  fileName  String?
  fileType  String?  // "pdf" | "image"
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, patientId])
  @@index([type])
}

model SpecialtyAnnotation {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  specialtyCode String
  regionId      String
  label         String
  color         String
  notes         String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  patient       Patient  @relation(fields: [patientId], references: [id])

  @@unique([clinicId, patientId, specialtyCode, regionId])
  @@index([clinicId, patientId])
}

model SystemEvent {
  id         String   @id @default(cuid())
  clinicId   String?
  type       String
  severity   String   @default("info")
  source     String
  title      String
  message    String?
  metadata   Json?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  clinic     Clinic?  @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([severity])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
}

model PharmacyProduct {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  genericName String?
  category    String    @default("أدوية")
  form        String?
  barcode     String?
  price       Int
  cost        Int       @default(0)
  stock       Int       @default(0)
  minStock    Int       @default(0)
  requiresRx  Boolean   @default(false)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  saleItems   PharmacySaleItem[]

  @@unique([clinicId, barcode])
  @@index([clinicId, active])
}

model PharmacySale {
  id            String   @id @default(cuid())
  clinicId      String
  number        Int
  subtotal      Int
  discount      Int      @default(0)
  total         Int
  cost          Int
  paymentMethod String   // cash | zaincash | debt
  customerName  String?
  customerPhone String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  items         PharmacySaleItem[]

  @@unique([clinicId, number])
  @@index([clinicId, createdAt])
}

model PharmacySaleItem {
  id        String          @id @default(cuid())
  saleId    String
  productId String
  name      String
  qty       Int
  price     Int
  cost      Int
  sale      PharmacySale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   PharmacyProduct @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model LabTest {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  nameEn    String?
  category  String   @default("أخرى")
  unit      String?
  price     Int      @default(0)
  refLowM   Float?
  refHighM  Float?
  refLowF   Float?
  refHighF  Float?
  critLow   Float?
  critHigh  Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  items     LabOrderItem[]

  @@index([clinicId, active])
}

model LabOrder {
  id           String    @id @default(cuid())
  clinicId     String
  number       Int
  patientName  String
  patientPhone String?
  sex          String    // m | f
  age          Int?
  doctorName   String?
  urgent       Boolean   @default(false)
  status       String    @default("new") // new | in_progress | review | done | cancelled
  total        Int       @default(0)
  paid         Boolean   @default(false)
  notes        String?
  publicToken  String    @unique
  sentAt       DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  items        LabOrderItem[]

  @@unique([clinicId, number])
  @@index([clinicId, status])
  @@index([clinicId, createdAt])
}

model LabOrderItem {
  id        String    @id @default(cuid())
  orderId   String
  testId    String?
  name      String
  unit      String?
  price     Int       @default(0)
  refLowM   Float?
  refHighM  Float?
  refLowF   Float?
  refHighF  Float?
  critLow   Float?
  critHigh  Float?
  result    Float?
  flag      String?   // normal | low | high | critical_low | critical_high | none
  enteredAt DateTime?
  order     LabOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test      LabTest?  @relation(fields: [testId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([testId])
}
